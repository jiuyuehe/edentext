{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "packages/edentext-vue/dist",
    "rootDir": "src/lib",
    "allowJs": false,
    "checkJs": false,
    "types": ["vite/client", "svelte"]
  },
  "include": [
    "src/lib/vue/**/*.ts",
    "src/lib/vue/**/*.vue",
    "src/lib/native/**/*.ts",
    "src/vite-env.d.ts"
  ],
  "exclude": []
}
